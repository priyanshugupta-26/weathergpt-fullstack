DATABASE_URL=sqlite:///./data/weathergpt.db
SCHEDULER_ENABLED=true
REFRESH_SECONDS=600
PROVIDER_TIMEOUT=12
SECURE_COOKIES=false
TRUSTED_MODELS=false
# Set an admin password with at least 12 characters to seed an administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional OpenAI-compatible chat provider; structured-data fallback works without it.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
