{
  "version": "1.0.0",
  "name": "disaster_prediction_pipeline",
  "algorithm": "XGBoost Classifier / Stratified Multi-Class Risk Engine",
  "features": [
    "temp_2m",
    "precip_1h",
    "rain_24h",
    "rain_48h",
    "wind_speed_10m",
    "wind_gusts_10m",
    "surface_pressure",
    "weather_code",
    "us_aqi",
    "pm2_5",
    "river_discharge",
    "elevation",
    "max_quake_mag",
    "quake_depth",
    "tsunami_flag",
    "gdacs_cyclone",
    "gdacs_volcano",
    "wind_pressure_shear",
    "precipitation_saturation_rate",
    "thermal_particulate_index"
  ],
  "input_format": "array",
  "preprocessing": "none",
  "probabilities_calibrated": true,
  "target_classes": [
    "avalanche",
    "blizzard",
    "cold_wave",
    "cyclone",
    "drought",
    "dust_storm",
    "earthquake",
    "flash_flood",
    "flood",
    "fog",
    "hailstorm",
    "heat_wave",
    "landslide",
    "lightning",
    "normal",
    "thunderstorm",
    "tsunami",
    "wildfire"
  ],
  "metrics": {
    "cv_accuracy_mean_pct": 98.65,
    "cv_accuracy_std_pct": 0.42,
    "f1_macro": 0.982
  },
  "notes": "20-feature model combining 17 raw sensors and 3 domain interaction indicators."
}
